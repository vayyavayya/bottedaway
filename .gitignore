# Skill-Based Agent Gitignore

# Runtime data
*.log
*.pyc
__pycache__/
.env
keys.env

# State files (generated)
config/*_state.json
state/

# Artifacts (handoff boundary - keep structure, ignore contents)
/mnt/data/reports/*.html
/mnt/data/exports/*.csv
/mnt/data/backups/*.json

# But keep directories
!/mnt/data/reports/.gitkeep
!/mnt/data/exports/.gitkeep
!/mnt/data/backups/.gitkeep

# Local testing
.test/
*.test.py

# Daily Driver runtime state (per-user; keep the directory)
data/daily_driver/*.json
data/daily_driver/*.jsonl
!data/daily_driver/.gitkeep
