# =============================================================================
# Hermes Agent — secrets.  Copy to ~/.hermes/.env  (chmod 600)
# NEVER commit the real filled-in version to git.
# =============================================================================

# ---- Telegram ---------------------------------------------------------------
# 1. Message @BotFather on Telegram -> /newbot -> get the token.
# 2. Message @userinfobot on Telegram -> get YOUR numeric user id.
TELEGRAM_BOT_TOKEN=123456789:PASTE_YOUR_BOTFATHER_TOKEN_HERE

# Comma-separated numeric user IDs allowed to talk to the bot.
# Start with just your own id. Everyone else is ignored / must pair.
TELEGRAM_ALLOWED_USERS=000000000

# ---- Model provider key (only if NOT using Nous Portal OAuth) ---------------
# Uncomment the one that matches `model:` in config.yaml.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
