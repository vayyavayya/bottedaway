# Copy to .env and adjust. Every value here is optional — the defaults work.
# Load it with: set -a; source .env; set +a; make run

# --- storage -----------------------------------------------------------------
# Point this at your synced folder (iCloud Drive, Syncthing, a NAS share...) and
# the library is just files you can also browse in Finder or the Files app.
DOCBOX_DATA_DIR=./data
# DOCBOX_LIBRARY_DIR=/Users/shared/Documents/Docbox
DOCBOX_INBOX_NAME=Inbox
DOCBOX_MAX_UPLOAD_MB=64

# --- auth --------------------------------------------------------------------
# Leave empty and a secret is generated into data/secret.key on first run.
DOCBOX_SECRET=
DOCBOX_SESSION_DAYS=90

# --- the model that reads documents ------------------------------------------
# nous | openai | openrouter | ollama
#
# PRIVACY: with any provider except `ollama`, the extracted text of every
# document — bank statements, medical letters, payslips — is sent to that
# provider's API. `ollama` keeps everything on this machine.
DOCBOX_LLM_PROVIDER=nous
DOCBOX_LLM_API_KEY=
# Leave the model empty to use the provider default (Hermes-4-70B for Nous).
# `make status` lists what your key can actually reach.
DOCBOX_LLM_MODEL=
# Only needed to point at a different host than the provider default.
DOCBOX_LLM_BASE_URL=
# Vision model, used only when OCR finds no text in a photo. Leave empty to skip.
DOCBOX_VISION_MODEL=
DOCBOX_LLM_TIMEOUT=180
DOCBOX_LLM_ENABLED=true

# Who lives here. The model is told these names, and a document that is clearly
# about one person is filed under them (see people_rules in routing.json).
DOCBOX_HOUSEHOLD=

# --- Google Drive (CamScanner auto-exports there) -----------------------------
DOCBOX_GDRIVE_ENABLED=false
# Path to a service-account JSON key. Share the Drive folder with that service
# account's email address — it then sees that folder and nothing else.
DOCBOX_GDRIVE_CREDENTIALS=
# Either the folder id (from its Drive URL) or its name.
DOCBOX_GDRIVE_FOLDER_ID=
DOCBOX_GDRIVE_FOLDER_NAME=CamScanner
# Where new Drive files land. Empty = the inbox.
DOCBOX_GDRIVE_INTO=
DOCBOX_GDRIVE_POLL_MINUTES=15

# --- scanning ----------------------------------------------------------------
# Default filter for share-sheet and Shortcut uploads (the in-app scanner asks).
# auto | magic | color | gray | bw | photo | none
DOCBOX_SCAN_MODE=auto
# Target DPI. Real quality is bounded by the capture — nothing is ever upscaled.
DOCBOX_SCAN_DPI=300
DOCBOX_SCAN_QUALITY=92
DOCBOX_SCAN_PAGE_SIZE=a4
# Invisible OCR text layer, so Spotlight and Files can search inside scans.
DOCBOX_SCAN_SEARCHABLE=true
# Fix sideways pages with tesseract's orientation detection (~1s per page).
DOCBOX_SCAN_AUTO_ORIENT=false

# --- filing ------------------------------------------------------------------
# Move confidently classified documents out of the inbox into folders.
# The rules live in <data>/routing.json and are yours to edit.
DOCBOX_AUTO_FILE=true

# --- OCR ---------------------------------------------------------------------
DOCBOX_OCR_ENABLED=true
DOCBOX_OCR_LANGS=eng+deu
DOCBOX_OCR_MAX_PAGES=3
DOCBOX_EXTRACT_MAX_CHARS=6000

# --- worker ------------------------------------------------------------------
DOCBOX_WORKER_ENABLED=true
DOCBOX_MAX_ATTEMPTS=3
