# OpenClaw Environment Configuration
# Solana Data Pipeline - Default to Helius

# REQUIRED: Helius API Key (get from https://helius.xyz)
# export HELIUS_API_KEY="your_helius_api_key_here"

# OPTIONAL: Birdeye API for memecoin scanner
# export BIRDEYE_API_KEY="your_birdeye_key"

# OPTIONAL: Telegram for whale alerts
# export WHALE_TELEGRAM_BOT_TOKEN="your_bot_token"
# export WHALE_TELEGRAM_CHANNEL="@your_channel"

# API Priority Configuration
# SOLANA_API_PRIMARY="helius"  # helius | solscan | birdeye
# SOLANA_API_FALLBACK="birdeye"  # birdeye | solscan
